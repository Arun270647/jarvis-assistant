      "lmstudio": {
        "kind": "openai_compat",
        "label": "LM Studio (on this PC)",
        "base_url": "http://127.0.0.1:1234/v1",
        "needs_key": false,
        "local": true,
        "model": "",
        "utility_model": "",
        "vision": null,
        "timeout_seconds": 300,
        "history_budget_tokens": 12000
      },
      "custom": {
        "kind": "openai_compat",
        "label": "Another OpenAI-compatible server",
        "base_url": "",
        "needs_key": false,
        "model": "",
        "utility_model": "",
        "vision": null
      }
    },
    "prices": {
      "claude-fable-5-1": {"input": 10.0, "output": 50.0, "cache_read": 0.25, "cache_write": 12.5},
      "claude-opus-5-5": {"input": 4.0, "output": 20.0, "cache_read": 0.2, "cache_write": 5.0},
      "claude-opus-5": {"input": 5.0, "output": 25.0, "cache_read": 0.5, "cache_write": 6.25},
      "claude-sonnet-5-5": {"input": 2.0, "output": 10.0, "cache_read": 0.2, "cache_write": 2.5},
      "claude-sonnet-5": {"input": 2.0, "output": 10.0, "cache_read": 0.2, "cache_write": 2.5},
      "claude-haiku-5-5": {"input": 0.1, "output": 0.5, "cache_read": 0.01, "cache_write": 0.125},
      "claude-haiku-4-5": {"input": 1.0, "output": 5.0, "cache_read": 0.1, "cache_write": 1.25}
    }
  },
  "pipeline": {
    "silence_timeout_ms": 400,
    "max_recording_ms": 20000,
    "early_bail_ms": 3000,
    "vad_threshold": 0.5
  },
  "tts": {
    "enabled": true,
    "engine": "kokoro",
    "fallback": "system",
    "system": {
      "voice": "",
      "rate": 0
    },
    "kokoro": {
      "voice": "af_heart",
      "model": "kokoro-v1.0.onnx",
      "model_dir": "kokoro",
      "speed": 1.0
    },
    "piper": {
      "voice": "en_US-amy-medium",
      "model_dir": "piper",
      "speaker_id": 0,
      "huggingface_base_url": "https://huggingface.co/rhasspy/piper-voices/resolve/main"
    },
    "chatterbox": {
      "python": "",
      "hf_home": "",
      "torch_home": "",
      "device": "cpu",
      "temperature": 0.8,
      "threads": 0,
      "startup_timeout_s": 600,
      "sentence_timeout_s": 90,
      "fallback": "kokoro",
      "cache_phrases": [
        "{name} is back."
      ]
    }
  },
  "coding_agent": {
    "cli": "claude",
    "custom_command": [],
    "default_project": "",
    "timeout_seconds": 300,
    "capture_output": true,
    "summarize_for_tts": true,
    "require_confirmation": true
  },
  "voice_approval": {
    "window_ms": 5000,
    "affirmative": ["yes", "yeah", "yep", "yup", "sure", "confirm", "go ahead", "do it", "go", "correct",
                    "affirmative", "proceed"],
    "negative": ["no", "nope", "nah", "cancel", "stop", "abort", "don't", "negative", "wait"],
    "high_risk": false
  },
  "apps": {
    "discover": true
  },
  "help": {
    "url": "https://jarvis-assistant-oss.vercel.app/guide"
  },
  "updates": {
    "url": "https://jarvis-assistant-oss.vercel.app/latest.json",
    "auto_check": true
  },
  "dry_run": false,
  "agent": {
    "max_turns": 120,
    "max_seconds": 600,
    "memory_context_items": 5,
    "max_tool_calls_per_request": 80,
    "full_access": false,
    "workspace_roots": [],
    "allowed_commands": [],
    "fault_injection": [],
    "task": {
      "max_tool_calls": 80,
      "max_seconds": 1800,
      "max_verify_attempts": 3,
      "max_nudges": 3,
      "idle_timeout_seconds": 180,
      "speak_progress": true
    }
  },
  "tools": {
    "approval_timeout_ms": 15000,
    "default_timeout_s": 20,
    "permissions": {},
    "groups": {
      "workspace_read": true,
      "workspace_write": false,
      "terminals": false,
      "desktop": false,
      "system": true,
      "email": false,
      "coding_agent": false
    },
    "untrusted_asks": true,
    "extensions": [],
    "profile": "auto",
    "custom_list": [],
    "preset": ""
  },
  "memory": {
    "history_in_ui": 60,
    "approval_required_kinds": ["preference", "convention"]
  },
  "gui": {
    "orb_style": "hud",
    "start_minimized": false,
    "close_to_tray": true,
    "autostart_pipeline": true,
    "startup_view": "orb"
  },
  "email": {
    "enabled": true,
    "preset": "custom",
    "smtp_host": "",
    "smtp_port": 465,
    "security": "ssl",
    "username": "",
    "from_address": "",
    "from_name": "",
    "trusted_recipients": [],
    "signature": ""
  },
  "chrome": {
    "default_profile": "",
    "user_data_dir": "",
    "blocked_domains": []
  },
  "greeting": {
    "enabled": true,
    "prefix": "{name} is back.",
    "batch_size": 25,
    "min_pool": 8,
    "prepare_after_idle_s": 20
  },
  "desktop": {
    "enabled": true,
    "screenshot_max_side": 1400
  },
  "terminal": {
    "font": "Cascadia Mono"
  }
}
