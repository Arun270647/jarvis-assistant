{
  "config_version": 4,
  "setup": {
    "complete": false,
    "step": "",
    "models": {}
  },
  "assistant": {
    "name": "Jarvis"
  },
  "audio": {
    "input_device_index": null,
    "sample_rate": 16000,
    "channels": 1,
    "dtype": "int16",
    "chunk_size": 512,
    "test_recording_seconds": 5
  },
  "stt": {
    "model_path": "small",
    "device": "cpu",
    "compute_type": "int8",
    "beam_size": 1
  },
  "llm": {
    "main": {
      "provider": "claude_code"
    },
    "utility": {
      "provider": "",
      "model": ""
    },
    "timeout_seconds": 120,
    "max_tokens": 16000,
    "history_budget_tokens": 60000,
    "daily_budget_usd": null,
    "warmup": true,
    "providers": {
      "claude_code": {
        "kind": "claude_code",
        "label": "Claude (your Claude account)",
        "model": "claude-sonnet-5-5",
        "utility_model": "claude-haiku-5-5",
        "effort": "medium",
        "cli_path": "claude",
        "timeout_seconds": 30,
        "session_reset_after": 100,
        "models": ["claude-sonnet-5-5", "claude-opus-5-5", "claude-haiku-5-5", "claude-fable-5-1"]
      },
      "anthropic": {
        "kind": "anthropic",
        "label": "Anthropic API (API key)",
        "base_url": "https://api.anthropic.com",
        "needs_key": true,
        "env_key": "ANTHROPIC_API_KEY",
        "model": "claude-sonnet-5-5",
        "utility_model": "claude-haiku-5-5",
        "effort": "medium",
        "models": ["claude-sonnet-5-5", "claude-opus-5-5", "claude-haiku-5-5", "claude-fable-5-1"]
      },
      "openai": {
        "kind": "openai_compat",
        "label": "OpenAI (API key)",
        "base_url": "https://api.openai.com/v1",
        "needs_key": true,
        "env_key": "OPENAI_API_KEY",
        "model": "",
        "utility_model": "",
        "vision": null
      },
      "openrouter": {
        "kind": "openai_compat",
        "label": "OpenRouter (API key)",
        "base_url": "https://openrouter.ai/api/v1",
        "needs_key": true,
        "env_key": "OPENROUTER_API_KEY",
        "model": "",
        "utility_model": "",
        "vision": null
      },
      "groq": {
        "kind": "openai_compat",
        "label": "Groq (API key)",
        "base_url": "https://api.groq.com/openai/v1",
        "needs_key": true,
        "env_key": "GROQ_API_KEY",
        "model": "",
        "utility_model": "",
        "vision": null
      },
      "gemini": {
        "kind": "openai_compat",
        "label": "Google Gemini (API key)",
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "needs_key": true,
        "env_key": "GEMINI_API_KEY",
        "model": "",
        "utility_model": "",
        "vision": null,
        "schema": "basic"
      },
      "ollama": {
        "kind": "openai_compat",
        "label": "Ollama (on this PC)",
        "base_url": "http://127.0.0.1:11434/v1",
        "needs_key": false,
        "local": true,
        "model": "",
        "utility_model": "",
        "vision": null,
        "timeout_seconds": 300,
        "history_budget_tokens": 12000
